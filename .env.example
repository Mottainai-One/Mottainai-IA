# ============================================================
# Mottainai IA Layer — Environment Variables
# Copie para .env e preencha os valores
# ============================================================

# LLM — Groq (gratuito: https://console.groq.com)
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# LLM de texto alternativo — Ollama Cloud (https://ollama.com)
# Use LLM_PROVIDER=ollama para ativá-lo. OLLAMA_API_KEY nunca deve ser versionada.
LLM_PROVIDER=groq
OLLAMA_API_KEY=your_ollama_key_here
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gpt-oss:20b

# LLM de texto local — Ollama em loopback, sem token e sem enviar conversas para fora.
# Baixe o modelo antes: ollama pull qwen2.5:7b-instruct
# Use LLM_PROVIDER=ollama_local para ativá-lo.
OLLAMA_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_LOCAL_MODEL=qwen2.5:7b-instruct

# Gemini Vision (gratuito: https://aistudio.google.com/app/apikey)
# Usado exclusivamente pelo Agente de Visão (análise de prateleira)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_VISION_MODEL=gemini-2.5-flash

# PostgreSQL (fonte da verdade do negócio)
POSTGRES_DSN=postgresql+asyncpg://mottainai:mottainai@localhost:5432/mottainai

# MongoDB (camada IA). MONGO_URL também é aceito como alias de MONGO_URI.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=mottainai
# DATABASE_URL também é aceito como alias de POSTGRES_DSN.

# Redis (rate limit e notificações temporárias)
REDIS_URL=redis://localhost:6379/0
# Use apenas letras e números para evitar necessidade de URL encoding no Docker.
REDIS_PASSWORD=troque_por_uma_senha_forte_apenas_letras_e_numeros
REDIS_MAX_CONNECTIONS=20
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
RATE_LIMIT_WINDOW_SECONDS=60
NOTIFICATION_TTL_SECONDS=604800

# Embeddings local (sem custo)
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Use true apenas quando o modelo já estiver em cache local.
TRANSFORMERS_OFFLINE=false

# API externa — Open-Meteo (gratuita, sem API key)
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Rate limit (requisições por usuário por minuto)
RATE_LIMIT_RPM=30

# Ambiente
ENV=development
LOG_LEVEL=INFO

# Sessões, autenticação e integrações MCP/A2A
SESSION_TIMEOUT_MINUTES=60
# Gere um segredo aleatório com pelo menos 32 caracteres. O placeholder é recusado pela API.
JWT_SECRET=CHANGE_ME_GENERATE_A_NEW_LOCAL_JWT_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
# Plano gratuito Groq: custo direto por token é zero. Ajuste apenas para projeção comparativa.
LLM_INPUT_COST_PER_MILLION_USD=0
LLM_OUTPUT_COST_PER_MILLION_USD=0
# Gere tokens aleatórios fortes; sem token configurado, MCP e A2A permanecem bloqueados.
MCP_SHARED_TOKEN=replace_with_a_strong_random_token
A2A_SHARED_TOKEN=replace_with_a_strong_random_token
# Cada token compartilhado fica restrito a uma única empresa. Use 0 para manter a integração bloqueada.
MCP_EMPRESA_ID=0
A2A_EMPRESA_ID=0
PUBLIC_BASE_URL=http://localhost:8000
